{
  "name": "media-saver",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Deliberately off. Request URLs carry the signed media link as a query
  // parameter, so invocation logs would retain pointers to someone's private
  // group content. Turn it on temporarily if you need to debug.
  "observability": { "enabled": false },
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": false }
  ]

  // When you're ready to put it on the real domain, add a route.
  // Create the DNS record + custom domain in the dashboard first, or let
  // wrangler do it by uncommenting this block and running `wrangler deploy`:
  //
  // ,"routes": [
  //   { "pattern": "save.example.com", "custom_domain": true }
  // ]
}
